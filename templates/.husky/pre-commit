#!/bin/sh
# Block direct commits to protected branches, then lint staged files.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
for protected in main master dev develop staging {{DEFAULT_BRANCH}}; do
  if [ "$branch" = "$protected" ]; then
    echo "✖ Direct commits to '$branch' are blocked."
    echo "  Create a branch: git checkout -b feature/<issue>-short-description"
    exit 1
  fi
done

npx lint-staged
